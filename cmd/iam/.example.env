SERVICE_ID=2

HTTP_SERVER_ADDR=":2008"
HTTP_SERVER_CERT_FILE=""
HTTP_SERVER_KEY_FILE=""
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=15s
HTTP_MAX_HEADER_BYTES=16384
# Connection-ticket token buckets, per IAM process. One token refills per interval.
# Each request consumes a subject token, including malformed/denied requests.
HTTP_TICKET_SUBJECT_INTERVAL=1s
HTTP_TICKET_SUBJECT_BURST=20
HTTP_TICKET_DEVICE_INTERVAL=5s
HTTP_TICKET_DEVICE_BURST=5
# Legacy total fallback: 1/4 subject slots, 3/4 device slots, unless overridden.
HTTP_TICKET_RATE_MAX_ENTRIES=65536
# Independent table capacities. New keys receive 503 when a table is full.
HTTP_TICKET_MAX_SUBJECT_ENTRIES=16384
HTTP_TICKET_MAX_DEVICE_ENTRIES=49152
# New devices beyond this per-subject cap receive 429; existing quotas remain.
HTTP_TICKET_MAX_DEVICES_PER_SUBJECT=5
## Auth0
#HTTP_SERVER_OIDC_ISSUER=https://your-tenant.us.auth0.com/
#HTTP_SERVER_OIDC_AUDIENCE=https://my-api
#HTTP_SERVER_OIDC_JWKS_URL=https://your-tenant.us.auth0.com/.well-known/jwks.json
# Keycloak
HTTP_SERVER_OIDC_ISSUER=http://localhost:8080/realms/iam-dev
HTTP_SERVER_OIDC_AUDIENCE=iam-api
HTTP_SERVER_OIDC_JWKS_URL=http://localhost:8080/realms/iam-dev/protocol/openid-connect/certs

# PUBLIC descriptor only; never mount the Hub private keyring here.
HUB_NOISE_DESCRIPTOR_FILE=""

# IAM only. Never copy this seed to Hub.
TICKET_SIGNING_KEY_ID=1
TICKET_SIGNING_PRIVATE_KEY="<base64-Ed25519-seed-32-bytes>"

SQL_DATABASE_USER="root"
SQL_DATABASE_PASSWORD=""
SQL_DATABASE_NAME=""
SQL_DATABASE_PRIMARY_ADDRESS="127.0.0.1:3306"
SQL_DATABASE_REPLICA_ADDRESSES=""
SQL_DATABASE_MAX_OPEN_CONNS=8
SQL_DATABASE_MAX_IDLE_CONNS=4
SQL_DATABASE_CONN_MAX_LIFETIME=30s
SQL_DATABASE_CONN_MAX_IDLE_TIME=0
